{
  "name": "mini-job-system",
  "version": "0.1.0",
  "private": true,
  "description": "Capstone Bab 10: mini distributed system (API + worker + SQLite) dengan fokus reliability dan observability.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "api": "node --disable-warning=ExperimentalWarning src/api.js",
    "worker": "node --disable-warning=ExperimentalWarning src/worker.js",
    "dashboard": "node --disable-warning=ExperimentalWarning src/dashboard.js",
    "lab": "node --disable-warning=ExperimentalWarning scripts/lab.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 --test-timeout=120000 \"test/*.test.js\"",
    "test:repeat": "node scripts/test-repeat.js",
    "experiment": "node --disable-warning=ExperimentalWarning scripts/experiment.js",
    "check": "node --disable-warning=ExperimentalWarning scripts/check-consistency.js",
    "csrf-check": "node scripts/csrf-check.js",
    "host-check": "node scripts/host-check.js",
    "doctor": "node --disable-warning=ExperimentalWarning scripts/doctor.js",
    "clean": "node --disable-warning=ExperimentalWarning scripts/clean.js",
    "compare": "node scripts/compare-results.js"
  }
}
